# Copy to .env (it's gitignored) and fill in what you use. Every setting is optional.

# AI quick-add (text or photo → events, chores, groceries). Leave blank to hide the feature.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5-mini
# OPENAI_REASONING_EFFORT=low

# Publish-only token for your own ntfy server (see ntfy/server.example.yml).
HOMEBASE_NTFY_TOKEN=

# Ports and paths (defaults shown)
# HOMEBASE_PORT=4830
# HOMEBASE_REMOTE_PORT=4831        # loopback-only "away from home" entrance; 0 disables it
# HOMEBASE_DB=./data/family.db
# HOMEBASE_PHOTOS=./data/photos
