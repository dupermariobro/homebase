# Copy to .env (it's gitignored) and fill in what you use. Every setting is optional.

# AI quick-add (text or photo → events, chores, groceries). Leave blank to turn it off.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5-mini
# OPENAI_REASONING_EFFORT=low

# Your own ntfy server (see ntfy/server.example.yml) and its publish-only token.
# The token is only ever sent to HOMEBASE_NTFY_URL.
HOMEBASE_NTFY_URL=
HOMEBASE_NTFY_TOKEN=

# Public address of the away-from-home entrance (e.g. your Tailscale Funnel URL).
HOMEBASE_PUBLIC_URL=

# Extra host names the tablet may use for the LAN listener (comma-separated).
# IPs, localhost and .local/.lan/.home.arpa/.ts.net names always work.
# HOMEBASE_ALLOWED_HOSTS=homebase.example.home

# Ports and paths (defaults shown)
# HOMEBASE_PORT=4830
# HOMEBASE_REMOTE_PORT=4831        # loopback-only "away from home" entrance; 0 disables it
# HOMEBASE_DB=./data/family.db
# HOMEBASE_PHOTOS=./data/photos
